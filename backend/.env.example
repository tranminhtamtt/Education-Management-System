PORT=5000
NODE_ENV=development

# MongoDB Atlas (Atlas -> Connect -> Drivers). Thay <user>/<password>/<cluster>.
# Cluster Atlas là replica set nên hỗ trợ multi-document transaction (bắt buộc cho thanh toán/ghi danh).
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ems_db?retryWrites=true&w=majority"
# Tùy chọn: ghi đè tên database nếu không đặt trong URI
MONGODB_DB=

# JWT Secret
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=24h

# Upload Directory
UPLOAD_DIR=uploads

# Tài khoản nhận tiền — phải trùng tài khoản đã liên kết trên SePay. Webhook phải là HTTPS.
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
# Tên ngân hàng đúng như trường "gateway" SePay gửi trong webhook (vd: Vietcombank, MBBank)
SEPAY_BANK_NAME=
# API Key cấu hình ở SePay -> Webhooks -> Chứng thực "API Key"; SePay gửi header "Authorization: Apikey <key>"
SEPAY_WEBHOOK_API_KEY=
# Token SePay User API (đối soát/khôi phục giao dịch). Không đưa lên frontend.
SEPAY_API_TOKEN=

# Chỉ dùng cho lệnh reset dữ liệu mẫu (npm run seed:reset). Không commit giá trị thật.
SEED_PASSWORD=
