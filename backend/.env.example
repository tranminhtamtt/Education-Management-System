PORT=5000
NODE_ENV=development

# TiDB Cloud Serverless Connection URL (MySQL Protocol)
# Lấy chuỗi kết nối từ console TiDB Cloud (Connect -> Prisma / MySQL)
# Định dạng: mysql://<prefix>.<user>:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/<database_name>?sslaccept=strict
DATABASE_URL="mysql://username:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/ems_db?sslaccept=strict"

# JWT Secret
JWT_SECRET=ems_super_secret_jwt_key_2026_fpt
JWT_EXPIRES_IN=24h

# Upload Directory
UPLOAD_DIR=uploads

